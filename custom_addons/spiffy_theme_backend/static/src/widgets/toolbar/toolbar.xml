<template id="toolbar_widget" xml:space="preserve">
    <t t-name="spiffy_theme_backend.toolbar">
        <t t-if="props.readonly">
            <span t-if="props.record.data[props.name]" class="o_form_uri" t-esc="props.record.data[props.name]"/>
        </t>
        <t t-else="">
            <div t-ref="editor" t-on-input="onInput">
            </div>
        </t>
    </t>
</template>