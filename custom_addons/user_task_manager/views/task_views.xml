<odoo>
    <data>
    <!--    Vista de tipo formulario-->
        <record id="user_task_form_view" model="ir.ui.view">
            <field name="name">user.task.form</field>
            <field name="model">user.task</field>
            <field name="arch" type="xml">
                <form string="Tarea del Usuario">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="priority"/>
                            <field name="state"/>
                            <field name="deadline"/>
                            <field name="user_id" readonly="1"/>
                            <field name="is_done" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    <!--    Vista tipo lista-->
        <record id="user_task_tree_view" model="ir.ui.view">
            <field name="name">user.task.tree</field>
            <field name="model">user.task</field>
            <field name="arch" type="xml">
                <tree string="Tareas">
                    <field name="name"/>
                    <field name="priority"/>
                    <field name="state"/>
                    <field name="deadline"/>
                    <field name="is_done" readonly="1"/>
                </tree>
            </field>
        </record>

    <!--    Accion / Principal -->
        <record id="action_user_task" model="ir.actions.act_window">
            <field name="name">Mis Tareas</field>
            <field name="res_model">user.task</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No hay tareas asignadas aun.
                </p>
                <p>
                    Desde aqui puedes gestionar tus tareas personales.
                </p>
            </field>
        </record>

    <!--    Menu-->
        <menuitem id="menu_user_task_root" name="Gestor de Tareas" sequence="10"/>
        <menuitem id="menu_user_task" name="Mis tareas" parent="menu_user_task_root" action="action_user_task" sequence="20"/>
    </data>
</odoo>